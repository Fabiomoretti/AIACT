NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase service role key is used server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Report delivery and BCC copy via Sender SMTP.
SENDER_SMTP_HOST=smtp.sender.net
SENDER_SMTP_PORT=587
SENDER_SMTP_SECURE=false
SENDER_SMTP_USER=INSERISCI_QUI_USERNAME_SMTP_SENDER
SENDER_SMTP_PASSWORD=INSERISCI_QUI_PASSWORD_SMTP_SENDER
SENDER_EMAIL_FROM=AI Act Readiness <info@fabiomoretti.com>

# MailerLite lead sync. The Report group and custom fields are created automatically.
MAILERLITE_API_TOKEN=INSERISCI_QUI_TOKEN_API_MAILERLITE
MAILERLITE_REPORT_GROUP_NAME=Report
MAILERLITE_REPORT_GROUP_ID=

# Optional commercial links used in report CTAs and email.
KIT_BASE_URL=https://example.com/kit-base-ai-act
CONSULTATION_URL=https://example.com/check-up-ai-act
COMPLIANCE_URL=https://example.com/compliance-ai-act

NEXT_PUBLIC_KIT_BASE_URL=https://example.com/kit-base-ai-act
NEXT_PUBLIC_CONSULTATION_URL=https://example.com/check-up-ai-act
NEXT_PUBLIC_COMPLIANCE_URL=https://example.com/compliance-ai-act
